# Agent Town desktop settings. Copy this file to `.env` in the app folder:
# next to "Agent Town.exe" on Windows, next to "Agent Town.app" on macOS, or the
# project root when running from source. Never commit `.env`.

# Fine-grained, read-only GitHub token (Contents: read, Pull requests: read).
GITHUB_TOKEN=github_pat_replace_me

# Optional. Uncomment to set these here instead of in Settings; values set here
# override Settings and show there as read-only.
# SECOND_BRAIN_REPO=your-user/second-brain
# ROSTER_URL=https://github.com/your-user/second-brain/blob/main/roster.md
